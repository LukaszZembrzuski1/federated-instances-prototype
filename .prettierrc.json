{
	"semi": true,
	"trailingComma": "es5",
	"singleQuote": true,
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"endOfLine": "crlf",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"quoteProps": "consistent",
	"jsxSingleQuote": true,
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": ["^@/(.*)$", "^[./]"],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"overrides": [
		{
			"files": ["*.css", "*.scss"],
			"options": {
				"tabWidth": 4,
				"useTabs": true,
				"printWidth": 100
			}
		},
		{
			"files": "*.json",
			"options": {
				"tabWidth": 4,
				"useTabs": true,
				"printWidth": 100
			}
		}
	]
}

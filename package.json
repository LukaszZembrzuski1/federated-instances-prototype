{
	"name": "mfe-applet-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"start-mf": "npm run build && npm run preview",
		"test": "jest --watch --onlyChanged",
		"test:ci": "jest --ci --coverage --maxWorkers=2",
		"prepare": "husky",
		"check:circular-deps": "eslint . && tsc && madge --circular --extensions ts,tsx,js,jsx src && jest"
	},
	"dependencies": {
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-error-boundary": "^6.0.0",
		"react-router": "7.12.0",
		"relativity-ui": "^2.8.17"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@jest/globals": "^29.7.0",
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.6",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jsdom": "^27.2.0",
		"madge": "^8.0.0",
		"prettier": "^3.4.2",
		"relativity-foundation-core": "^2.0.10",
		"relativity-foundation-react": "^2.0.10",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.3.2"
	},
	"engines": {
		"node": ">= 24"
	}
}
